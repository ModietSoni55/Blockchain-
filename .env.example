# Optional: MedSupply Sentinel runs locally with zero required secrets.
# All variables below are optional overrides for custom local setups.

# Server port (defaults to 3000)
# PORT=3000

# Optional local Anvil / EVM RPC node for live on-chain dual-write anchoring
# RPC_URL="http://127.0.0.1:8545"
# SENTINEL_CONTRACT_ADDRESS="0x5FbDB2315678afecb367f032d93F642f64180aa3"
# ISSUER_PRIVATE_KEY="0x..."

# Optional standalone Python FastAPI AI Risk microservice URL
# FASTAPI_AI_URL="http://127.0.0.1:8000"

# GEMINI_API_KEY="MY_GEMINI_API_KEY"
# APP_URL="MY_APP_URL"
