# ==============================================================================
# MedSupply Sentinel - Backend Environment Variables
# 100% Free & Local Configuration (Zero Paid Services Required)
# ==============================================================================

# Application Environment & Server Config
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Local SQLite Database URL (Zero cloud database required)
DATABASE_URL="sqlite+aiosqlite:///./medsupply_sentinel.db"
SYNC_DATABASE_URL="sqlite:///./medsupply_sentinel.db"

# JWT & Cryptographic Security Keys
SECRET_KEY="medsupply-sentinel-ultra-secure-local-jwt-signing-key-change-in-prod"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# QR Cryptographic HMAC Attestation Secret Key
QR_HMAC_SECRET="super-secret-hmac-key-for-qr-attestation-signing-entropy"
QR_NONCE_TTL_SECONDS=86400

# Blockchain (Local Anvil EVM by default)
BLOCKCHAIN_RPC_URL="http://127.0.0.1:8545"
CHAIN_ID=31337

# Deployed Smart Contract Addresses (Populated automatically after forge deployment)
MEDSUPPLY_SENTINEL_ADDRESS="0x5FbDB2315678afecb367f032d93F642f64180aa3"
MEDICINE_PACK_NFT_ADDRESS="0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512"
COLD_CHAIN_ORACLE_ADDRESS="0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0"
QR_ATTESTATION_ADDRESS="0xCf7Ed3AccA5a467e9e704C703E8D87F634fB0Fc9"
REGULATOR_GOVERNANCE_ADDRESS="0xDc64a140Aa3E981100a9becA4E685f962f0cF6C9"

# Local Server Signer Wallet (Oracle / Sentinel Backend Relay)
BACKEND_OPERATOR_PRIVATE_KEY="0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80"

# AI / ML Local Model Configuration
AI_MODEL_PATH="./app/ai/models"
AI_RISK_THRESHOLD_HIGH=75.0
AI_RISK_THRESHOLD_CRITICAL=90.0
AI_ISOLATION_FOREST_CONTAMINATION=0.05
