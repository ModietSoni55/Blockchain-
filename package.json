  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "doctor": "node scripts/check-local.mjs",
    "predev": "node scripts/check-local.mjs --quiet",
    "dev": "tsx server.ts",
    "prestart": "node scripts/check-local.mjs --quiet",
    "start": "tsx server.ts",
    "start:prod": "tsx server.ts --prod",
    "build": "vite build",
    "preview": "vite preview",
    "test": "tsx --test src/utils/sentinelLogic.test.ts server/securityIntegration.test.ts",
    "clean": "node -e \"const fs=require('fs'); for(const p of ['dist','server.js']) fs.rmSync(p,{recursive:true,force:true});\"",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3-geo": "^3.1.1",
    "@types/qrcode": "^1.5.6",
    "@types/react-simple-maps": "^3.0.6",
    "@vitejs/plugin-react": "^6.1.1",
    "d3-geo": "^3.1.2",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-simple-maps": "^5.0.5",
    "us-atlas": "^3.0.1",
    "viem": "^2.57.19",
    "vite": "^8.3.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
